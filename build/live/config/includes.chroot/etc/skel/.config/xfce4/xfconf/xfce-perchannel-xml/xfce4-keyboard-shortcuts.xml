<?xml version="1.0" encoding="UTF-8"?>

<!--
  Carsai OS - Windows-style keyboard shortcuts with a hacker twist.
  Only deltas over the XFCE defaults are defined here; XFCE's built-in
  bindings (Alt+F4, Alt+Tab, ...) keep working.
-->

<channel name="xfce4-keyboard-shortcuts" version="1.0">
  <property name="commands" type="empty">
    <property name="default" type="empty">
      <property name="&lt;Primary&gt;&lt;Alt&gt;t" type="string" value="xfce4-terminal"/>
      <property name="&lt;Super&gt;Return" type="string" value="xfce4-terminal"/>
      <property name="&lt;Super&gt;e" type="string" value="thunar"/>
      <property name="&lt;Super&gt;r" type="string" value="xfce4-appfinder --collapsed"/>
      <property name="&lt;Super&gt;l" type="string" value="xflock4"/>
      <property name="&lt;Super&gt;v" type="string" value="xfce4-popup-clipman"/>
      <property name="&lt;Super&gt;" type="string" value="xfce4-popup-whiskermenu"/>
      <property name="&lt;Primary&gt;&lt;Alt&gt;Delete" type="string" value="xfce4-taskmanager"/>
      <property name="Print" type="string" value="xfce4-screenshooter -f"/>
      <property name="&lt;Alt&gt;Print" type="string" value="xfce4-screenshooter -w"/>
      <property name="&lt;Shift&gt;Print" type="string" value="xfce4-screenshooter -r"/>
    </property>
  </property>
  <property name="xfwm4" type="empty">
    <property name="default" type="empty">
      <!-- snap: Win+arrows (Windows style) -->
      <property name="&lt;Super&gt;Left" type="string" value="tile_left"/>
      <property name="&lt;Super&gt;Right" type="string" value="tile_right"/>
      <property name="&lt;Super&gt;Up" type="string" value="maximize_window"/>
      <property name="&lt;Super&gt;Down" type="string" value="hide"/>
      <!-- show desktop: Win+D -->
      <property name="&lt;Super&gt;d" type="string" value="show_desktop"/>
      <!-- workspaces: Ctrl+Alt+arrows (classic) + Ctrl+Win+arrows (Windows style) -->
      <property name="&lt;Primary&gt;&lt;Alt&gt;Left" type="string" value="left_workspace"/>
      <property name="&lt;Primary&gt;&lt;Alt&gt;Right" type="string" value="right_workspace"/>
      <property name="&lt;Control&gt;&lt;Super&gt;Left" type="string" value="left_workspace"/>
      <property name="&lt;Control&gt;&lt;Super&gt;Right" type="string" value="right_workspace"/>
      <!-- direct workspace jump: Win+1..4 -->
      <property name="&lt;Super&gt;1" type="string" value="workspace_1"/>
      <property name="&lt;Super&gt;2" type="string" value="workspace_2"/>
      <property name="&lt;Super&gt;3" type="string" value="workspace_3"/>
      <property name="&lt;Super&gt;4" type="string" value="workspace_4"/>
    </property>
  </property>
</channel>
