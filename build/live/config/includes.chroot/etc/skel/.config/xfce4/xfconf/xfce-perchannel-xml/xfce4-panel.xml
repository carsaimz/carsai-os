<?xml version="1.0" encoding="UTF-8"?>

<!--
  Carsai OS - default XFCE panel layout.
  Panel 1 (top): rich statusbar - start menu, workspaces, genmon system
                 feed (carsai-statusbar), system load, tray, audio, clock.
  Panel 2 (bottom): Windows/Android-style dock - pinned launchers,
                 tasklist, show desktop. Auto-hides when not needed.
-->

<channel name="xfce4-panel" version="1.0">
  <property name="configver" type="int" value="2"/>
  <property name="dark-mode" type="bool" value="true"/>
  <property name="panels" type="empty">
    <property name="panel-1" type="empty">
      <property name="position" type="string" value="p=6;x=0;y=0"/>
      <property name="length" type="double" value="100.000000"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="size" type="uint" value="30"/>
      <property name="autohide-behavior" type="uint" value="0"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="1"/>
        <value type="int" value="2"/>
        <value type="int" value="3"/>
        <value type="int" value="4"/>
        <value type="int" value="5"/>
        <value type="int" value="6"/>
        <value type="int" value="7"/>
        <value type="int" value="8"/>
        <value type="int" value="9"/>
      </property>
    </property>
    <property name="panel-2" type="empty">
      <property name="position" type="string" value="p=2;x=0;y=0"/>
      <property name="length" type="double" value="100.000000"/>
      <property name="nrows" type="uint" value="1"/>
      <property name="size" type="uint" value="46"/>
      <property name="icon-size" type="uint" value="2"/>
      <property name="autohide-behavior" type="uint" value="1"/>
      <property name="plugin-ids" type="array">
        <value type="int" value="11"/>
        <value type="int" value="12"/>
        <value type="int" value="13"/>
        <value type="int" value="14"/>
        <value type="int" value="15"/>
        <value type="int" value="16"/>
      </property>
    </property>
  </property>
  <property name="plugins" type="empty">
    <!-- top panel -->
    <property name="plugin-1" type="string" value="whiskermenu"/>
    <property name="plugin-1" type="empty">
      <property name="button-icon" type="string" value="carsai-os"/>
      <property name="show-tooltips" type="bool" value="true"/>
    </property>
    <property name="plugin-2" type="string" value="pager"/>
    <property name="plugin-2" type="empty">
      <property name="rows" type="uint" value="1"/>
    </property>
    <property name="plugin-3" type="string" value="separator"/>
    <property name="plugin-3" type="empty">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-4" type="string" value="genmon"/>
    <property name="plugin-4" type="empty">
      <property name="command" type="string" value="carsai-statusbar"/>
      <property name="period" type="int" value="3"/>
    </property>
    <property name="plugin-5" type="string" value="systemload"/>
    <property name="plugin-5" type="empty">
      <property name="load-text" type="bool" value="false"/>
      <property name="tooltip-format" type="string" value="CPU: %average&#10;RAM: %memory&#10;Swap: %swap&#10;Uptime: %uptime"/>
    </property>
    <property name="plugin-6" type="string" value="separator"/>
    <property name="plugin-6" type="empty">
      <property name="expand" type="bool" value="false"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-7" type="string" value="systray"/>
    <property name="plugin-7" type="empty">
      <property name="show-frame" type="bool" value="false"/>
    </property>
    <property name="plugin-8" type="string" value="pulseaudio"/>
    <property name="plugin-9" type="string" value="clock"/>
    <property name="plugin-9" type="empty">
      <property name="mode" type="uint" value="2"/>
      <property name="digital-format" type="string" value="%H:%M:%S"/>
      <property name="tooltip-format" type="string" value="%A, %d/%m/%Y"/>
    </property>
    <!-- bottom dock -->
    <property name="plugin-11" type="string" value="launcher"/>
    <property name="plugin-11" type="empty">
      <property name="items" type="array">
        <value type="string" value="/usr/share/applications/xfce4-terminal.desktop"/>
      </property>
    </property>
    <property name="plugin-12" type="string" value="launcher"/>
    <property name="plugin-12" type="empty">
      <property name="items" type="array">
        <value type="string" value="/usr/share/applications/thunar.desktop"/>
      </property>
    </property>
    <property name="plugin-13" type="string" value="launcher"/>
    <property name="plugin-13" type="empty">
      <property name="items" type="array">
        <value type="string" value="/usr/share/applications/firefox-esr.desktop"/>
      </property>
    </property>
    <property name="plugin-14" type="string" value="launcher"/>
    <property name="plugin-14" type="empty">
      <property name="items" type="array">
        <value type="string" value="/usr/share/applications/org.xfce.mousepad.desktop"/>
      </property>
    </property>
    <property name="plugin-15" type="string" value="tasklist"/>
    <property name="plugin-15" type="empty">
      <property name="grouping" type="bool" value="true"/>
      <property name="show-labels" type="bool" value="false"/>
    </property>
    <property name="plugin-16" type="string" value="separator"/>
    <property name="plugin-16" type="empty">
      <property name="expand" type="bool" value="true"/>
      <property name="style" type="uint" value="0"/>
    </property>
    <property name="plugin-17" type="string" value="showdesktop"/>
  </property>
</channel>
