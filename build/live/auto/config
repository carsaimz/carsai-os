#!/bin/sh
# Carsai OS - live-build configuration
# Recipe: Debian 12 (bookworm), amd64, XFCE, lean services, Carsai branding.
# Called by scripts/build-iso.sh (or manually from build/live/).
set -e

lb config noauto \
        --mode debian \
        --distribution bookworm \
        --archive-areas "main contrib non-free non-free-firmware" \
        --architecture amd64 \
        --apt-recommends false \
        --binary-images iso-hybrid \
        --bootappend-live "boot=live components quiet timezone=Africa/Maputo" \
        --debian-installer none \
        --iso-application "Carsai OS" \
        --iso-publisher "Carsai Mozambique; https://github.com/carsaimz; https://github.com/carsaimz/carsai-os" \
        --iso-volume "CARSAIOS" \
        --mirror-bootstrap http://deb.debian.org/debian \
        --mirror-chroot http://deb.debian.org/debian \
        --mirror-chroot-security http://security.debian.org/debian-security \
        --mirror-binary http://deb.debian.org/debian \
        --mirror-binary-security http://security.debian.org/debian-security \
        "${@}"
