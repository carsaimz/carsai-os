<?xml version="1.0" encoding="UTF-8"?>

<!--
  Carsai OS - xsettings defaults. Carsai-Neon is the out-of-the-box
  theme; the selector (and first-run hook) rewrites ThemeName on change.
-->

<channel name="xsettings" version="1.0">
  <property name="Net" type="empty">
    <property name="ThemeName" type="string" value="Carsai-Neon"/>
    <property name="IconThemeName" type="string" value="Carsai"/>
    <property name="CursorThemeName" type="string" value="Adwaita"/>
    <property name="CursorSize" type="int" value="24"/>
    <property name="FontName" type="string" value="Noto Sans 10"/>
    <property name="MonospaceFontName" type="string" value="JetBrains Mono 11"/>
    <property name="EnableEventSounds" type="bool" value="false"/>
    <property name="EnableInputFeedbackSounds" type="bool" value="false"/>
  </property>
  <property name="Gtk" type="empty">
    <property name="MenuImages" type="bool" value="true"/>
    <property name="ButtonImages" type="bool" value="true"/>
  </property>
</channel>
